# The backend listens on localhost by default. Change HOST only when the
# network path is protected by Tailscale, Cloudflare Access, or an equivalent.
HOST=127.0.0.1
PORT=3847

# Set a long random value before allowing access from another device.
AGENTBRIDGE_ACCESS_TOKEN=

# Comma-separated browser origins allowed to call the API during development.
# Same-origin production requests do not require an entry.
AGENTBRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend port for `npm run dev`. By default it uses 5173, or the
# next free port when Windows has reserved 5173.
# AGENTBRIDGE_WEB_PORT=

# Optional location for SQLite, uploads, logs, and runtime configuration.
# AGENTBRIDGE_DATA_DIR=

# Postgres connection used to store the AgentBridge UI login account
# (username, hashed password, encrypted TOTP secret). Runs in Docker:
# `docker compose up -d`, then `npm run setup:auth` once to create the account.
AGENTBRIDGE_PG_HOST=127.0.0.1
AGENTBRIDGE_PG_PORT=5433
AGENTBRIDGE_PG_USER=agentbridge
AGENTBRIDGE_PG_PASSWORD=change-me
AGENTBRIDGE_PG_DATABASE=agentbridge

# 32+ character random value used to encrypt the TOTP secret at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AGENTBRIDGE_AUTH_SECRET=change-me
