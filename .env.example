# The backend listens on localhost by default. Change HOST only when the
# network path is protected by Tailscale, Cloudflare Access, or an equivalent.
HOST=127.0.0.1
PORT=3847

# Set a long random value before allowing access from another device.
AGENTBRIDGE_ACCESS_TOKEN=

# Comma-separated browser origins allowed to call the API during development.
# Same-origin production requests do not require an entry.
AGENTBRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional location for SQLite, uploads, logs, and runtime configuration.
# AGENTBRIDGE_DATA_DIR=
